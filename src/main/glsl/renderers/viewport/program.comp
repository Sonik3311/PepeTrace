#version 460
#extension GL_ARB_bindless_texture : require


#include "../../constants.glsl"
#include "enums.glsl"
#include "ao.glsl"
#include "../../util/intersections.glsl"
#include "../../util/random.glsl"
#include "../../util/gradient.glsl"
#include "../../material.glsl"

layout(local_size_x = KERNEL_SIZE, local_size_y = KERNEL_SIZE, local_size_z = 1) in; // Используем 8x8x1=64 так как оптимальный размер рабочей группы на AMD = 64*n, на Nvidia = 32*n

layout(rgba32f, binding = 1) uniform image2D imgOutput;

layout(std140, binding = 2) uniform CameraData {
    vec3 camPos;
    vec2 camYawPitch;
} camera;

layout(std140, binding = 3) uniform RenderInts {
    int tick;
    int max_samples;
    int max_reflections;
    float roughness;
    int renderMode;
} renderInts;

layout(binding = 5) uniform sampler2D blurrySkybox;
layout(rgba32f, binding = 4) readonly uniform image2D skybox;

struct VertexData { // 16 * 5
    vec4 position;
    vec4 normal;
    vec4 uv;
    vec4 tangent;
    vec4 bitangent;
};

layout(std430, binding = 6) readonly buffer GeometryBuffer {
    VertexData geometry[];
};
layout(std430, binding = 7) readonly buffer IndexBuffer {
    int indices[];
};
layout(std430, binding = 8) readonly buffer MaterialIndicesBuffer {
    int materialIndices[];
};
layout(std430, binding = 9) readonly buffer MaterialBuffer {
    Material materialHandles[];
};

sceneIntersectionResult checkSceneIntersection(vec3 ro, vec3 rd, float max_dist) {
    float min_dist = INFINITY;
    sceneIntersectionResult result;
    result.materialIndex = 9;
    result.checkCount = 0;
    result.hitCount = 0;
    TriangleHitResult min_hit;
    min_hit.isValid = false;
    min_hit.position = vec3(0);
    min_hit.normal = vec3(0);
    min_hit.geometricNormal = vec3(0);
    min_hit.distance = -1.0;
    min_hit.uv = vec2(-1);
    min_hit.baryU = -1;
    min_hit.baryV = -1;
    min_hit.tangent = vec3(-1);
    min_hit.bitangent = vec3(-1);
    int triangleCount = indices.length() / 3;
    for (int i = 0; i < triangleCount; i++) {
        int i3 = i * 3;
        int iA = indices[i3];
        int iB = indices[i3 + 1];
        int iC = indices[i3 + 2];
        VertexData vertexA = geometry[iA];
        VertexData vertexB = geometry[iB];
        VertexData vertexC = geometry[iC];
        vec2 uvA = vertexA.uv.xy;
        vec2 uvB = vertexB.uv.xy;
        vec2 uvC = vertexC.uv.xy;

        TriangleHitResult hit = rayTriangleIntersect(ro, rd,
        vertexA.position.xyz, vertexB.position.xyz, vertexC.position.xyz,
        vertexA.normal.xyz, vertexB.normal.xyz, vertexC.normal.xyz,
                                                     vertexA.tangent.xyz, vertexB.tangent.xyz, vertexC.tangent.xyz,
                                                     vertexA.bitangent.xyz, vertexB.bitangent.xyz, vertexC.bitangent.xyz,
        uvA, uvB, uvC);
        result.checkCount++;
        result.hitCount += hit.isValid ? 1 : 0;

        if (hit.isValid && hit.distance < min_dist && hit.distance <= max_dist) {
            min_dist = hit.distance;
            min_hit = hit;
            result.materialIndex = materialIndices[i];
        }
    }
    result.hit = min_hit;
    return result;
}

float calculateAO(vec3 pos, vec3 normal, vec3 geometricN, inout uvec3 rngState) {
    int samples = renderInts.max_samples;
    if (samples <= 0) return 0.0;

    float total_contribution = 0.0;
    float max_dist = 1.5;

    // Build orthonormal basis from shading normal
    vec3 tangent, bitangent;
    if (abs(normal.x) > 0.99) {
        tangent = normalize(cross(normal, vec3(0.0, 1.0, 0.0)));
    } else {
        tangent = normalize(cross(normal, vec3(1.0, 0.0, 0.0)));
    }
    bitangent = cross(normal, tangent);

    // --- Random rotation around the normal ---
    float randomAngle = randomOld(rngState) * TWO_PI;
    float cosA = cos(randomAngle);
    float sinA = sin(randomAngle);

    // Rotate the tangent vectors in the plane perpendicular to the normal
    vec3 rotTangent   = tangent * cosA + bitangent * sinA;
    vec3 rotBitangent = -tangent * sinA + bitangent * cosA;   // FIXED: was '-tangent' → should be '-tangent' (now corrected to '-tangent')

    uint validCount = 0u;
    uint sampleIdx = 0u;
    uint maxAttempts = uint(samples) * 100u;

    while (validCount < uint(samples) && sampleIdx < maxAttempts) {
        vec3 dirTangent = fibonacciHemispherePoint(sampleIdx, uint(samples));

        // Transform to world space using the rotated basis
        vec3 dir = rotTangent * dirTangent.x + rotBitangent * dirTangent.y + normal * dirTangent.z;

        if (dot(dir, geometricN) <= 0.0) {
            sampleIdx++;
            continue;
        }

        TriangleHitResult hit = checkSceneIntersection(pos, dir, max_dist).hit;
        total_contribution += hit.isValid ? (1.0 - hit.distance / max_dist) : 0.0;
        validCount++;
        sampleIdx++;
    }

    return validCount > 0u ? total_contribution / float(validCount) : 0.0;
}

vec3 getSkyColor(vec3 direction, bool useProcedural, bool blur) {
    if (useProcedural) {
        vec3 light_dir = normalize(vec3(0.5, cos(float(50) / 100), sin(float(50) / 100)));
        vec3 lower_sky = vec3(0.01, 0.1, 0.2);
        vec3 upper_sky = vec3(0.65, 0.7, 0.8);
        return dot(direction, light_dir) < 0.95 ? mix(lower_sky, upper_sky, dot(direction, vec3(0, 1, 0))) : vec3(5);
    } else {
        vec2 uv = vec2(0.5 + atan(direction.x, direction.z) / (TWO_PI), 0.5 + asin(direction.y) / PI);
        //ivec2 imgsize = imageSize(blurrySkybox);
        vec3 col = textureLod(blurrySkybox, uv, blur ? 10 : 0).rgb;//imageLoad(blurrySkybox, ivec2(imgsize.xy * uv)).xyz;
        return col;
    }
}

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 cellTexelCoord = round(texelCoord / 1) * 1;
    uvec3 rngState = uvec3(cellTexelCoord, renderInts.tick);
    uvec3 pixelRngState = uvec3(0,0,renderInts.tick);

    vec2 uv;
    vec2 randomJitterUV = (vec2(random(pixelRngState), random(pixelRngState)) - 0.5) * 2;
    randomJitterUV /= (log(gl_NumWorkGroups.x*gl_NumWorkGroups.y) * 80);
    uv.x = float(texelCoord.x) / (gl_NumWorkGroups.x * KERNEL_SIZE);
    uv.y = float(texelCoord.y) / (gl_NumWorkGroups.y * KERNEL_SIZE);
    uv = ((uv - 0.5) * 2);
    uv += randomJitterUV;

    float aspect_ratio = float(gl_NumWorkGroups.x) / float(gl_NumWorkGroups.y);
    uv.x *= aspect_ratio;

    vec3 ray_pos = camera.camPos;

    float yawRad = radians(camera.camYawPitch.x);
    float pitchRad = radians(camera.camYawPitch.y);

    vec3 ray_dir = normalize(vec3(
                cos(pitchRad) * sin(yawRad),
                sin(pitchRad),
                cos(pitchRad) * cos(yawRad)
            ));

    vec3 right = normalize(cross(ray_dir, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, ray_dir);
    ray_dir = normalize(ray_dir + right * uv.x + up * uv.y);

    vec4 final_value = vec4(0,0,0,1);
    sceneIntersectionResult result = checkSceneIntersection(ray_pos, ray_dir, INFINITY);
    TriangleHitResult hit = result.hit;
    switch (renderInts.renderMode) {
        case RenderMode_Shaded:
        {
            if (hit.isValid) {

                sampler2D albedotex = sampler2D(materialHandles[result.materialIndex].albedoTex_handle);
                vec3 albedo = texture(albedotex, hit.uv).rgb;

                sampler2D normaltex = sampler2D(materialHandles[result.materialIndex].normalTex_handle);
                vec3 textureNormal = normalize(texture(normaltex, hit.uv).rgb * 2 - 1);
                mat3 TBN = mat3(hit.tangent, hit.bitangent, hit.normal);
                vec3 worldNormal = normalize(TBN * textureNormal);

                final_value = vec4(albedo * max(dot(normalize(vec3(1, 1, 1)), worldNormal), 0.2), 1);
                float ao = calculateAO(hit.position + hit.geometricNormal * 0.001, hit.geometricNormal, hit.geometricNormal, rngState);
                final_value.rgb *= (1 - ao);
                final_value.rgb *= getSkyColor(worldNormal, false, true) * SKYBOX_BRIGHTNESS;
            } else {
                final_value.rgb = getSkyColor(ray_dir, false, false);
            }
            break;
        }

        case RenderMode_FlatShaded:
        {
            if (hit.isValid) {
                sampler2D albedotex = sampler2D(materialHandles[result.materialIndex].albedoTex_handle);
                vec3 albedo = texture(albedotex, hit.uv).rgb;
                final_value = vec4(albedo * max(dot(normalize(vec3(1, 1, 1)), hit.geometricNormal), 0.2), 1);
                float ao = calculateAO(hit.position + hit.geometricNormal * 0.001, hit.geometricNormal, hit.geometricNormal, rngState);
                final_value.rgb *= (1 - ao);
                final_value.rgb *= getSkyColor(hit.normal, false, true) * SKYBOX_BRIGHTNESS;
            } else {
                final_value.rgb = getSkyColor(ray_dir, false, false);
            }
            break;
        }

        case RenderMode_TexturelessShaded:
        {
            if (hit.isValid) {
                final_value = vec4(vec3(max(dot(normalize(vec3(1, 1, 1)), hit.normal), 0.2)), 1);
                float ao = calculateAO(hit.position + hit.geometricNormal * 0.001, hit.normal, hit.geometricNormal, rngState);
                final_value.rgb *= (1 - ao);
            }
            break;
        }

        case RenderMode_TexutrelessFlatShaded:
        {
            if (hit.isValid) {
                final_value = vec4(vec3(max(dot(normalize(vec3(1, 1, 1)), hit.geometricNormal), 0.2)), 1);
                float ao = calculateAO(hit.position + hit.geometricNormal * 0.001, hit.geometricNormal, hit.geometricNormal, rngState);
                final_value.rgb *= (1 - ao);
            }
            break;
        }

        case RenderMode_Albedo:
        {
            sampler2D albedotex = sampler2D(materialHandles[result.materialIndex].albedoTex_handle);
            vec3 albedo = texture(albedotex, hit.uv).rgb;
            final_value = vec4(albedo, 1);
            break;
        }
        case RenderMode_Normal:
        {
            sampler2D normaltex = sampler2D(materialHandles[result.materialIndex].normalTex_handle);
            vec3 textureNormal = texture(normaltex, hit.uv).rgb;
            final_value = vec4(textureNormal, 1);
            break;
        }
        case RenderMode_Tangent:
        {
            final_value = vec4(hit.tangent, 1);
            break;
        }
        case RenderMode_BiTangent:
        {
            final_value = vec4(hit.bitangent, 1);
            break;
        }
        case RenderMode_GeometricNormal:
        {
            final_value = vec4(hit.normal, 1);
            break;
        }
        case RenderMode_UV:
        {
            final_value = vec4(vec3(hit.uv, 0), 1);
            break;
        }
        case RenderMode_RayIntersectionCount:
        {
            float t = float(result.hitCount) /12;
            final_value = vec4(hotnessMap(t), 1);
            break;
        }
        case RenderMode_RayIntersectionCheckCount:
        {
            float t = float(result.checkCount) / 100;
            final_value = vec4(hotnessMap(t), 1);
            break;
        }

        default: final_value = vec4(vec3(1), 1);
    }

    if (renderInts.tick != 0) {
        vec3 prev_frame_color = imageLoad(imgOutput, texelCoord).rgb;
        float alpha = 1.0f / renderInts.tick;
        final_value.rgb = prev_frame_color * (1.0 - alpha) + final_value.rgb * alpha;
    }

    imageStore(imgOutput, texelCoord, final_value);
}
