#version 460 core

#include "../../constants.glsl"
#include "intersections.glsl"
#include "cameraUtil.glsl"
#include "../../util/random.glsl"
#include "../../util/matconversion.glsl"
#include "pbr.glsl"

layout(local_size_x = KERNEL_SIZE, local_size_y = KERNEL_SIZE, local_size_z = 1) in;

struct VertexData {
    vec4 position;
    vec4 normal;
    vec4 uv;
    vec4 tangent;
    vec4 bitangent;
};

struct ModelMatricies {
    mat4 forwardM;
    mat4 inverseM;
};

layout(std430, binding = 6) readonly buffer GeometryBuffer {
    VertexData geometry[];
};

layout(std430, binding = 7) readonly buffer IndexBuffer {
    int indices[];
};

layout(std430, binding = 8) readonly buffer MaterialIndicesBuffer {
    int materialIndices[];
};

layout(std430, binding = 10) readonly buffer ModelMatrices {
    ModelMatricies modelMatricies[];
};

layout(std430, binding = 11) readonly buffer TriangleModelIndices {
    int triangleModelIndices[];
};

layout(std140, binding = 30) uniform RenderSettings {
    int frame;
    int samples;
    int bounces;
    int triangleCount;
};

layout(std140, binding = 29) uniform CameraData {
    vec3 position;
    vec2 yawPitch;
} camera;

layout(binding = 4) uniform sampler2D skybox;

#define ALBEDO_BASE 10
layout(binding = ALBEDO_BASE) uniform sampler2D albedoTextures[MAX_MATERIALS];
layout(binding = ALBEDO_BASE + MAX_MATERIALS) uniform sampler2D normalTextures[MAX_MATERIALS];
layout(binding = ALBEDO_BASE + 2 * MAX_MATERIALS) uniform sampler2D rmttTextures[MAX_MATERIALS];

layout(rgba32f, binding = 16) uniform image2D imgOutput;
layout(rgba32f, binding = 17) uniform image2D imgAlbedo;
layout(rgba32f, binding = 18) uniform image2D imgNormal;

vec3 getSkyColor(vec3 direction) {
    vec2 uv = vec2(0.5 + atan(direction.x, direction.z) / (2 * PI), 0.5 + asin(direction.y) / PI);
    return texture(skybox, uv).rgb;
}

SceneIntersectionResult checkSceneIntersection(vec3 ro, vec3 rd, float max_dist) {
    float min_dist = INFINITY;
    SceneIntersectionResult result;
    result.materialIndex = -1;
    result.triangleIndex = -1;
    result.modelIndex = -1;
    result.checkCount = 0;
    result.hitCount = 0;
    TriangleHitResult min_hit;
    min_hit.isValid = false;
    min_hit.position = vec3(0);
    min_hit.normal = vec3(0);
    min_hit.geometricNormal = vec3(0);
    min_hit.distance = -1.0;
    min_hit.uv = vec2(-1);
    min_hit.baryU = -1;
    min_hit.baryV = -1;
    min_hit.tangent = vec3(-1);
    min_hit.bitangent = vec3(-1);
    int triCount = indices.length() / 3;
    int modelIdx = 0;
    for (int i = 0; i < triCount; i++) {
        if (modelIdx < triangleModelIndices.length() - 1) {
            if (i >= triangleModelIndices[modelIdx + 1]) modelIdx++;
        }
        mat4 invModelMat = modelMatricies[modelIdx].inverseM;
        vec3 localRo = (invModelMat * vec4(ro, 1.0)).xyz;
        vec3 localRd = (invModelMat * vec4(rd, 0.0)).xyz;

        int i3 = i * 3;
        int iA = indices[i3];
        int iB = indices[i3 + 1];
        int iC = indices[i3 + 2];
        VertexData vertexA = geometry[iA];
        VertexData vertexB = geometry[iB];
        VertexData vertexC = geometry[iC];
        vec2 uvA = vertexA.uv.xy;
        vec2 uvB = vertexB.uv.xy;
        vec2 uvC = vertexC.uv.xy;

        TriangleHitResult hit = rayTriangleIntersect(localRo, localRd,
                vertexA.position.xyz, vertexB.position.xyz, vertexC.position.xyz,
                vertexA.normal.xyz, vertexB.normal.xyz, vertexC.normal.xyz,
                vertexA.tangent.xyz, vertexB.tangent.xyz, vertexC.tangent.xyz,
                vertexA.bitangent.xyz, vertexB.bitangent.xyz, vertexC.bitangent.xyz,
                uvA, uvB, uvC);
        result.checkCount++;
        result.hitCount += hit.isValid ? 1 : 0;

        if (hit.isValid && hit.distance < min_dist && hit.distance <= max_dist) {
            min_dist = hit.distance;
            min_hit = hit;
            result.materialIndex = materialIndices[i];
            result.triangleIndex = i;
            result.modelIndex = modelIdx;
        }
    }
    result.hit = min_hit;
    return result;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(imgOutput);
    if (coord.x >= imgSize.x || coord.y >= imgSize.y) return;

    // Foveated: render 1 of every 2×2 block each frame, cycling through 4 patterns
    int px = frame & 1;
    int py = (frame >> 1) & 1;
    if ((coord.x & 1) != px || (coord.y & 1) != py) return;

    uvec3 rngState = uvec3(coord, frame);

    vec2 uv;
    uv.x = float(coord.x) / float(imgSize.x);
    uv.y = float(coord.y) / float(imgSize.y);
    uv = ((uv - 0.5) * 2);
    uv.x *= float(imgSize.x) / float(imgSize.y);

    // Anti-alias: jitter ray within pixel
    float pixelSize = 2.0 / float(imgSize.y);
    uv += (vec2(random(rngState), random(rngState)) - 0.5) * pixelSize;

    vec3 ray_dir = getRayDirection(uv, camera.yawPitch);

    vec4 accum = imageLoad(imgOutput, coord);
    vec4 albedoAccum = imageLoad(imgAlbedo, coord);
    vec4 normalAccum = imageLoad(imgNormal, coord);
    float prevCount = accum.a;
    vec3 prevColor = accum.rgb;
    vec3 newColor = vec3(0);

    // First-hit data (same for all samples of this pixel)
    vec3 firstAlbedo = vec3(0);
    vec3 firstNormal = vec3(0);

    for (int iter = 0; iter < samples; iter++) {
        vec3 ray_pos = camera.position;
        vec3 rd = ray_dir;
        vec3 color = vec3(0);
        vec3 energy = vec3(1);

        for (int bounce = 0; bounce < bounces; bounce++) {
            SceneIntersectionResult result = checkSceneIntersection(ray_pos, rd, INFINITY);
            TriangleHitResult hit = result.hit;
            if (!hit.isValid) {
                color += energy * getSkyColor(rd);
                break;
            }

            ModelMatricies matrices = modelMatricies[result.modelIndex];
            mat3 M = mat3(matrices.forwardM);
            int matIdx = result.materialIndex;
            vec3 albedo;
            vec3 worldNormal;
            if (matIdx >= 0 && matIdx < MAX_MATERIALS) {
                albedo = texture(albedoTextures[matIdx], hit.uv).rgb;
                vec3 mapN = texture(normalTextures[matIdx], hit.uv).xyz * 2.0 - 1.0;
                vec3 N = normalize(hit.normal);
                vec3 T = normalize(hit.tangent - dot(hit.tangent, N) * N);
                vec3 B = cross(N, T);
                mat3 TBN = mat3(T, B, N);
                worldNormal = normalize(M * normalize(TBN * mapN));
            } else {
                albedo = vec3(1.0);
                worldNormal = normalize(M * hit.normal);
            }

            // Capture first-hit albedo and world-space normal for OIDN aux channels
            if (bounce == 0) {
                firstAlbedo = albedo;
                firstNormal = worldNormal;
            }
            vec3 geometricNormal = normalize(M * hit.geometricNormal);

            // Bump-terminator fix: if the shading normal puts V in the lower
            // hemisphere, microfacet BRDFs are undefined — sampling and PDF
            // both break, producing bright fireflies at silhouettes/creases.
            // Fall back to the geometric normal for this bounce.
            vec3 V = normalize(-rd);
            if (dot(worldNormal, V) <= 1e-4) {
                worldNormal = geometricNormal;
            }

            // Read PBR material properties from RMT texture
            float roughness = 0.5;
            float metallic = 0.0;
            float transparency = 0.0;
            if (matIdx >= 0 && matIdx < MAX_MATERIALS) {
                vec3 rmt = texture(rmttTextures[matIdx], hit.uv).rgb;
                roughness = rmt.r;
                metallic = rmt.g;
                transparency = rmt.b;
            }

            // Transparency: probabilistically pass through without surface interaction
            if (random(rngState) < transparency) {
                ray_pos = localToGlobal(hit.position, matrices.forwardM) + rd * EPSILON * 100;
                continue;
            }

            float alpha = max(roughness * roughness, 0.01);
            vec3 F0 = mix(vec3(0.04), albedo, metallic);
            float NdotV = max(dot(worldNormal, V), 1e-5);
            vec3 F = fresnelSchlick(F0, NdotV);
            float specProb = clamp((F.r + F.g + F.b) / 3.0, 0.1, 0.9);

            vec3 L;
            vec3 H;
            float NdotL;

            vec2 rnd = vec2(random(rngState), random(rngState));

            if (random(rngState) < specProb) {
                L = sampleGGXVNDF(V, worldNormal, alpha, rnd);
                NdotL = max(dot(L, worldNormal), 0.0);
                if (NdotL <= 0.0) {
                    energy = vec3(0.0);
                    break;
                }
                H = normalize(V + L);
            } else {
                L = sampleCosineHemisphere(worldNormal, rnd);
                NdotL = max(dot(L, worldNormal), 0.0);
                if (NdotL <= 0.0) {
                    energy = vec3(0.0);
                    break;
                }
                H = normalize(V + L);
            }

            // Evaluate full Cook-Torrance BRDF at sampled direction
            float NdotH = max(dot(worldNormal, H), 1e-5);
            float LdotH = max(dot(L, H), 1e-5);

            vec3 F_term = fresnelSchlick(F0, LdotH);

            float D = ggxNDF(worldNormal, H, alpha);
            float G1_v = smithGGX_G1(worldNormal, V, alpha);
            float G = G1_v * smithGGX_G1(worldNormal, L, alpha);
            vec3 specular = D * G * F_term / max(4.0 * NdotV * NdotL, 1e-6);

            vec3 diffuse = (1.0 - F_term) * (1.0 - metallic) * albedo / PI;

            vec3 brdf = specular + diffuse;
            float pdf_s = D * G1_v / (4.0 * NdotV);
            float pdf_d = NdotL / PI;
            float misPdf = specProb * pdf_s + (1.0 - specProb) * pdf_d;
            float weight = NdotL / max(misPdf, 1e-6);

            // Reject if sampled direction is below geometric normal (prevents energy focusing in creases)
            if (dot(L, geometricNormal) <= 0.0) {
                energy = vec3(0.0);
                break;
            }

            energy *= brdf * weight;

            vec3 hitPos = localToGlobal(hit.position, matrices.forwardM);
            ray_pos = hitPos + geometricNormal * EPSILON * 100;
            rd = L;
        }
        newColor += color;
    }

    float totalCount = prevCount + samples;
    vec3 totalColor = prevColor + newColor;
    imageStore(imgOutput, coord, vec4(totalColor, totalCount));

    // Accumulate first-hit albedo (same for all samples)
    imageStore(imgAlbedo, coord,
        vec4(albedoAccum.rgb + firstAlbedo * samples, albedoAccum.a + samples));

    // Accumulate first-hit normal in [0,1] range (bias for storage)
    vec3 normal01 = firstNormal * 0.5 + 0.5;
    imageStore(imgNormal, coord,
        vec4(normalAccum.rgb + normal01 * samples, normalAccum.a + samples));
}
